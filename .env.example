# Todas las variables son opcionales: la app ya trae los links de la planilla
# y valores por defecto en src/config.ts.

# Links CSV de la planilla publicada (Archivo > Compartir > Publicar en la Web).
# Definir VITE_SHEET_MENU_URL vacío usa el menú local de src/data/products.ts.
# VITE_SHEET_MENU_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv
# VITE_SHEET_CONFIG_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=...&single=true&output=csv

# Respaldo si la pestaña Config no carga. Formato internacional, solo dígitos
# (Argentina: 549 + código de área sin 0 + número sin 15).
VITE_WHATSAPP_NUMBER=5491234567890
VITE_STORE_NAME="Entre Migas"
