# Links CSV de la planilla de Google (Archivo > Compartir > Publicar en la Web,
# una pestaña por link, formato "Valores separados por comas (.csv)").
# Obligatorio en producción. En desarrollo, si falta el de Menu, se usa el menú local.
VITE_SHEET_MENU_URL=https://docs.google.com/spreadsheets/d/e/<ID>/pub?gid=0&single=true&output=csv
VITE_SHEET_CONFIG_URL=https://docs.google.com/spreadsheets/d/e/<ID>/pub?gid=<GID_CONFIG>&single=true&output=csv

# Opcionales: respaldo si la pestaña Config no carga. WhatsApp en formato
# internacional, solo dígitos (Argentina: 549 + área sin 0 + número sin 15).
VITE_WHATSAPP_NUMBER=5491234567890
VITE_STORE_NAME="Entre Migas"
